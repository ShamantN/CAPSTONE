# Auto-detect text files and normalize line endings
* text=auto

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.onnx binary
*.pdf binary

# Git LFS tracking for curated visual artifacts
docs_generated/**/*.png filter=lfs diff=lfs merge=lfs -text
docs_generated/**/*.jpg filter=lfs diff=lfs merge=lfs -text
results/curated/**/*.png filter=lfs diff=lfs merge=lfs -text
